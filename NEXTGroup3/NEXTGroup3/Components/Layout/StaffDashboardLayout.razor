@inherits LayoutComponentBase

<div class="page">

    <main>
        <div class="next-logo">
            <img src="Next Careers Logo.png">
        </div>
        <div class=" question-nav-style nav nav-btn">

            <h2 class="btn">Return Home</h2>
        </div>
        <div class="container">

            <div class="sidebar">
                <StaffNavMenu></StaffNavMenu>
            </div>

            <article class="content px-4">
