@inherits LayoutComponentBase

<div class="page">

    <main>
        <div class="layout-container">

            <div class="next-logo">
                <img src="Next Careers Logo.png">
            </div>
            <div class="login-btn-container">
                <a href="/CandidateLogin" class="login-btn btn">LOGIN</a>
                <span class="divider"></span>
                <a href="/StaffLogin" class="login-btn btn">I AM AN EMPLOYEE</a>
            </div>
            
        </div>
        <div class="menu-bar-style nav nav-btn">

            <a href="/" class="btn back-home-button">Return Home</a>


        </div>
        <div class="container">


            <article class="content px-4">
                @Body
            </article>
        </div>
        
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
