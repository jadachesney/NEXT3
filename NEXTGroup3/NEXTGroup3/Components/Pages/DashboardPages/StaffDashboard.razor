@page "/staffdashboard"
@namespace NEXTGroup3.Components.Pages.DashboardPages
@layout StaffDashboardLayout
@rendermode InteractiveServer
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory
@using NEXTGroup3.Components.Layout
@using NEXTGroup3.Services
@inject StaffDashboardService dashboardService
@inject IJSRuntime jsRunTime;
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>


<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>Dashboard</h1>

        <h3>Staff ID:</h3>

        <h3>Staff role:</h3>
    </div>
</div>

