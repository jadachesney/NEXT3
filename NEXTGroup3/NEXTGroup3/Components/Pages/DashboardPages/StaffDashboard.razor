<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 chart-container">
            <canvas id="bar-chart" width="400" height="300" class=""></canvas>
        </div>
        @* <div class="col-md-4 chart-container"> *@
        @*     POSSIBLE PIE OR DOUGHNUT CHART *@
        @* </div> *@
    </div>
    

</div>


<script src="_framework/blazor.server.js"></script>

<script>
    function CreateChart(departments, data, colors){ 

    new Chart(document.getElementById("bar-chart"),  
    { 
    type: 'bar', 
    data:  
    { 
    labels: departments, 
    datasets:  
    [ 
    { 
    label: "Popularity", 
    backgroundColor: colors, 
    data: data, 
    borderWidth: 1 
    } 
    ] 
    }, 
    options:  
    { 
    legend: { display: false }, 
    devicePixelRatio: 4,
    responsive: false, 
    title:  
    { 
    display: true,
    text: '' 
    }, 

    scales: 
    { 
    yAxes:  
    [{ 
    scaleLabel:  
    { 
    display: true, 
    labelString: 'Popularity', 
    color: '#000000' 
    },
    ticks:{
    beginAtZero: true
    }
    }], 

    xAxes:  
    [{ 
    scaleLabel:  
    { 
    display: true, 
    labelString: 'Department', 
    color: '#000000' 
    } 
    }] 
    } 
    } 
    }); 
    }
</script> 


@code {

    private List<string> DepartmentChartColors = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        await dashboardService.GetDepartments();
        await dashboardService.GetOverallPoints();
        StateHasChanged();

        await base.OnInitializedAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        string[] potentialColors = ["#2274A5", "#FFBE0B", "#D62828", "#00A878"];
        int currentColor = 0;
        foreach(var dep in dashboardService.Departments)
        {

            DepartmentChartColors.Add(potentialColors[currentColor]);

            if (currentColor < potentialColors.Length - 1)
            {
                currentColor++;
            }
            else { currentColor = 0; }
        }
        await CreateChartAsync();
        await base.OnAfterRenderAsync(firstRender);
    }
    public async Task CreateChartAsync(){
        await jsRunTime.InvokeVoidAsync("CreateChart", await dashboardService.GetDepartmentStringList(), dashboardService.DepartmentPointsToDoubleList(), DepartmentChartColors);
    }
    


