@page "/staffdashboard"
@layout StaffDashboardLayout
@rendermode InteractiveAuto
@inject AuthenticationStateProvider authenticationStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using NEXTGroup3.Components.Layout
@using Microsoft.AspNetCore.Authorization
@using NEXTGroup3.Services
@using System.Security.Claims
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
@attribute [Authorize(Roles = "Admin, Staff")]
@inject IJSRuntime jsRunTime;


<CascadingAuthenticationState>
  <AuthorizeView Context="authContext">
    <Authorized>
      <div class="dashboard-container">
        <div class="dashboard-header">
          <h1>Dashboard</h1>

          <h3>Staff ID:</h3>

          <h3>Staff role:</h3>
        </div>
      </div>
                @* <div class="border-3">  *@
          @*      @if (departmentBarChart != null)  *@
          @*      {  *@
          @*          <BarChart @ref="departmentBarChart" Class="m-4 border-3 border-dark" Height="300" Width="400" />  *@
          @*      }  *@
          @*      else  *@
          @*      {  *@
          @*          <p>BarChart component is not rendered.</p>  *@
          @*      }  *@
          @*  </div>  *@
      <div class="container-fluid">
        <div class="row">
          <div class="col-md-8 chart-container">
            <canvas id="bar-chart" width="400" height="300" class=""></canvas>
          </div>
                  @* <div class="col-md-4 chart-container"> *@
                  @*     POSSIBLE PIE OR DOUGHNUT CHART *@
                  @* </div> *@
        </div>


      </div>
    </Authorized>
    <NotAuthorized></NotAuthorized>
  </AuthorizeView>
</CascadingAuthenticationState>

<script src="_framework/blazor.server.js"></script>

<script>
  function CreateChart(departments, data, colors){

  new Chart(document.getElementById("bar-chart"),
  {
  type: 'bar',
  data:
  {
  labels: departments,
  datasets:
  [
  {
  label: "Popularity",
  backgroundColor: colors,
  data: data,
  borderWidth: 1
  }
  ]
  },
  options:
  {
  legend: { display: false },
  devicePixelRatio: 4,
  responsive: false,
  title:
  {
  display: true,
  text: ''
  },

  scales:
  {
  yAxes:
  [{
  scaleLabel:
  {
  display: true,
  labelString: 'Popularity',
  color: '#000000'
  },
  ticks:{
  beginAtZero: true
  }
  }],

  xAxes:
  [{
  scaleLabel:
  {
  display: true,
  labelString: 'Department',
  color: '#000000'
  }
  }]
  }
  }
  });
  }
</script>


<canvas id="bar-chart" width="400" height="300" class="bar-styling mt-2"></canvas>

<script>

  new Chart(document.getElementById("bar-chart"), {
      type: 'bar',
      data: {
          labels: ["IT", "Finance", "Marketing", "Design", "Trading", "Merchandising"],
          datasets: [
              {
                  label: "Popularity",
                  backgroundColor: ["#000000", "#f7550d", "#000000", "#000000", "#000000", "#f7550d"],
                  data: [542, 600, 534, 484, 433, 200, 100],
                  borderWidth: 1


              }
          ]
      },
      options: {
          legend: { display: false },
          responsive: false,
          title: {
              display: true,
              text: ''
          },

          scales:
          {
              yAxes: [{
                  scaleLabel: {
                      display: true,
                      labelString: 'Popularity',
                      color: '#000000'
                  }
              }],

              xAxes: [{
                  scaleLabel: {
                      display: true,
                      labelString: 'Department',
                      color: '#000000'
                  }
              }]
          }
      }
  });
</script>


@code {

    // LOGIN BRANCH
  [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; }
  private string name;

  protected override async Task OnInitializedAsync()
  {
    var authstate = await AuthenticationState;
    var user = authstate.User;

    if (user.Identity != null && user.Identity.IsAuthenticated)
    {
      name = user.FindFirst(ClaimTypes.Name)?.Value ?? "Unknown User";
    }
    else
    {
      name = "Guest";
    }

