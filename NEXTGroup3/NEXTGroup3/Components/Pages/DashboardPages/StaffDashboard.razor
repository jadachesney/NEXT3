@page "/staffdashboard"
@layout StaffDashboardLayout
@rendermode InteractiveAuto
@inject AuthenticationStateProvider authenticationStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using NEXTGroup3.Components.Layout
@* @using Microsoft.AspNetCore.Authorization *@
@using NEXTGroup3.Services
@using System.Security.Claims
@inject StaffDashboardService dashboardService
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
@inject IJSRuntime jsRunTime;
@* @attribute [Authorize(Roles = "Admin, Staff")] *@

@* <CascadingAuthenticationState> *@
@*   <AuthorizeView Context="authContext"> *@
@*     <Authorized> *@
<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>Analytics</h1>
    </div>
    <div class="dashboard-body">
        <div class="container-fluid staff-dashboard">
            <div class="item-row chart-items">
                <div class="staff-dashboard-item bar-chart">
                    <div class="chart-container">
                        <canvas id="bar-chart" class="department-bar-chart"></canvas>
                    </div>
                </div>
                <div class="staff-dashboard-item ring-chart">
                    <div class="chart-container">
                        <canvas id="ring-chart" class="department-ring-chart"></canvas>
                    </div>
                </div> 
            </div>
            <div class="item-row text-items">
                <div class="col-md-4 staff-dashboard-item">  
                    <h2 class="item-header">Highest Matched Department</h2>
                    <hr class="item-header-break"/>
                    @if(dashboardService.HighestDepartment != null){
                        <h3 class="item-content">@dashboardService.HighestDepartment.Name</h3>
                    }
                </div>
                <div class="col-md-4 staff-dashboard-item">
                    <h2 class="item-header">Questionnaires Completed</h2>
                    <hr class="item-header-break" />

                    @if (dashboardService.ResultsCount != 0)
                    {
                        <h3 class="item-content">@dashboardService.ResultsCount</h3>
                    }
                </div>
                <div class="col-md-4 staff-dashboard-item">
                    <h2 class="item-header">Placeholder</h2>                    
                    <hr class="item-header-break" />
                    <h3 class="item-content">placeholder</h3>
                </div>
            </div>


        </div>
    </div>

</div>

@*     </Authorized> *@
@*     <NotAuthorized></NotAuthorized> *@
@*   </AuthorizeView> *@
@* </CascadingAuthenticationState> *@

<script src="_framework/blazor.server.js"></script>
<script src="js/chart-scripts.js"></script>


@code {

    // LOGIN BRANCH
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; }
    private string name;

    protected override async Task OnInitializedAsync()
    {
        var authstate = await AuthenticationState;
        var user = authstate.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            name = user.FindFirst(ClaimTypes.Name)?.Value ?? "Unknown User";
        }
        else
        {
            name = "Guest";
        }

        StateHasChanged();

        await base.OnInitializedAsync();
    }

    // CHART FUNCTIONALITY
    private List<string> DepartmentChartColors = new List<string>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await dashboardService.GetDepartments();
            await dashboardService.GetOverallPoints();
            string[] potentialColors = ["#2274A5", "#FFBE0B", "#D62828", "#00A878"];
            int currentColor = 0;
            foreach (var dep in dashboardService.Departments)
            {

                DepartmentChartColors.Add(potentialColors[currentColor]);

                if (currentColor < potentialColors.Length - 1)
                {
                    currentColor++;
                }
                else { currentColor = 0; }
            }
            await jsRunTime.InvokeVoidAsync("CreateBarChart", await dashboardService.GetDepartmentStringList(), dashboardService.DepartmentPointsToDoubleList(), DepartmentChartColors);

            await jsRunTime.InvokeVoidAsync("CreateRingChart", await dashboardService.GetDepartmentStringList(), dashboardService.DepartmentPointsToDoubleList(), DepartmentChartColors);
        }
        await base.OnAfterRenderAsync(firstRender);
  }
  

}
