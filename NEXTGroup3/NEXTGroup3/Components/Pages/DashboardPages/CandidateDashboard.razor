    @code {

    // LOGIN BRANCH
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; }
        private string name;

        protected override async Task OnInitializedAsync()
        {
            var authstate = await AuthenticationState;
            var user = authstate.User;


            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                name = user.FindFirst(ClaimTypes.Name)?.Value ?? "Unknown User";
            }
            else
            {
                name = "Guest";
            }


            StateHasChanged();

            await base.OnInitializedAsync();
            await Task.CompletedTask;
        }

        // CHART FUNCTIONALITY
        private List<string> DepartmentChartColors = new List<string>();

        protected override async Task OnAfterRenderAsync(bool firstRender)
        {
            if (firstRender)
            {
                await dashboardService.GetDepartments();
                await dashboardService.GetOverallPoints();

                await dashboardService.DepartmentPointsToDoubleList();
                string[] potentialColors = ["#2274A5", "#FFBE0B", "#D62828", "#00A878"];
                int currentColor = 0;
                foreach (var dep in dashboardService.Departments)
                {

                    DepartmentChartColors.Add(potentialColors[currentColor]);

                    if (currentColor < potentialColors.Length - 1)
                    {
                        currentColor++;
                    }
                    else { currentColor = 0; }
                }
                await jsRunTime.InvokeVoidAsync("CreateBarChart", await dashboardService.GetDepartmentStringList(), dashboardService.DepartmentDoubleList, DepartmentChartColors);

                await jsRunTime.InvokeVoidAsync("CreateRingChart", await dashboardService.GetDepartmentStringList(), dashboardService.DepartmentDoubleList, DepartmentChartColors);
            }
            await base.OnAfterRenderAsync(firstRender);
        }


    }
