@page "/candidatedashboard"
@layout CandidateDashboardLayout
@rendermode InteractiveAuto
@inject AuthenticationStateProvider authenticationStateProvider
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using NEXTGroup3.Components.Layout
@using NEXTGroup3.Services
@using System.Security.Claims
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
@attribute [Authorize (Roles = "Admin, Candidate")]

<CascadingAuthenticationState>
  <AuthorizeView Context="authContext">
    <Authorized>
      <div class="dashboard-container">
          <div class = "dashboard-header">
              <h1>Dashboard: Welcome @name</h1>

              <h3>Current role:</h3>

              <h3>Current department:</h3>
          </div>
      </div>
    </Authorized>
    <NotAuthorized></NotAuthorized>
  </AuthorizeView>
</CascadingAuthenticationState>


<NavLink href="questionpage" class="mt-2 retake-btn">
    Retake Questionnaire
</NavLink>

@code {
  [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; }
  private string name;

  protected override async Task OnInitializedAsync()
  {
    var authstate = await AuthenticationState;
    var user = authstate.User;

    if (user.Identity != null && user.Identity.IsAuthenticated)
    {
      name = user.FindFirst(ClaimTypes.Name)?.Value ?? "Unknown User";
    }
    else
    {
      name = "Guest";
    }
  }
}

<canvas id="bar-chart" width="400" height="300" class="bar-styling mt-2"></canvas>


<script>

    new Chart(document.getElementById("bar-chart"), {
        type: 'bar',
        data: {
            labels: ["IT", "Finance", "Marketing", "Design", "Trading", "Merchandising"],
            datasets: [
                {
                    label: "Match %",
                    backgroundColor: ["#000000", "#f7550d", "#000000", "#000000", "#f7550d", "#000000"],
                    data: [20, 40, 10, 8, 2, 10, 20],
                    borderWidth: 1


                }
            ]
        },
        options: {
            legend: { display: false },
            responsive: false,
            title: {
                display: true,
                text: ''
            },

            scales:
            {
                yAxes: [{
                    scaleLabel: {
                        display: true,
                        labelString: 'Match Percentage',
                        color: '#000000'
                    }
                }],

                xAxes: [{
                    scaleLabel: {
                        display: true,
                        labelString: 'Department',
                        color: '#000000'
                    }
                }]
            }
        }
    });
</script>