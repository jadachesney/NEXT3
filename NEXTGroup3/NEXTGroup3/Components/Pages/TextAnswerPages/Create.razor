@page "/textanswers/create"
@using Microsoft.EntityFrameworkCore
@using NEXTGroup3.Models
@using NEXTGroup3.Components.Layout
@layout StaffDashboardLayout
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>TextAnswer</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="TextAnswer" OnValidSubmit="AddTextAnswer" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="answers" class="form-label">Text:</label> 
                <InputText id="answers" @bind-Value="TextAnswer.Answers" class="form-control" /> 
                <ValidationMessage For="() => TextAnswer.Answers" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="roleid" class="form-label">Role Id:</label> 
                <InputNumber id="roleid" @bind-Value="TextAnswer.RoleId" class="form-control" /> 
                <ValidationMessage For="() => TextAnswer.RoleId" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/textanswers">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private TextAnswer TextAnswer { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddTextAnswer()
    {
        using var context = DbFactory.CreateDbContext();
        context.TextAnswer.Add(TextAnswer);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/textanswers");
    }
}
