@page "/textanswers/delete"
@using Microsoft.EntityFrameworkCore
@using NEXTGroup3.Models
@using NEXTGroup3.Components.Layout
@layout StaffDashboardLayout
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>TextAnswer</h2>
    <hr />
    @if (textanswer is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Answers</dt>
            <dd class="col-sm-10">@textanswer.Answers</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">RoleId</dt>
            <dd class="col-sm-10">@textanswer.RoleId</dd>
        </dl>
        <EditForm method="post" Model="textanswer" OnValidSubmit="DeleteTextAnswer" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(textanswer is null)">Delete</button> |
            <a href="/textanswers">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private TextAnswer? textanswer;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Finds the textanswer details from the database based on the Id of it
        using var context = DbFactory.CreateDbContext();
        textanswer = await context.TextAnswer.FirstOrDefaultAsync(m => m.Id == Id);

        if (textanswer is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteTextAnswer()
    {
       // Removes the textanswer from the database
        using var context = DbFactory.CreateDbContext();
        context.TextAnswer.Remove(textanswer!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/textanswers");
    }
}
