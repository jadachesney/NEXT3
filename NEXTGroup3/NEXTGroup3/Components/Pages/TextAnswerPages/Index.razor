@page "/textanswers"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using NEXTGroup3.Components.Layout
@using NEXTGroup3.Models
@using NEXTGroup3.Data
@implements IAsyncDisposable
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory
@layout StaffDashboardLayout

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="textanswers/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.TextAnswer.Include(TextAnswer => TextAnswer.Role)">
    <PropertyColumn Property="textanswer => textanswer.Answers" />
    <PropertyColumn Property="textanswer => textanswer.Role.Name" />

    <TemplateColumn Context="textanswer" class="icon-tb">
        <a href="@($"textanswers/edit?id={textanswer.Id}")"><i class="fa-solid fa-pen"></i></a> |
        <a href="@($"textanswers/details?id={textanswer.Id}")"><i class="fa-solid fa-info"></i></a> |
        <a href="@($"textanswers/delete?id={textanswer.Id}")"><i class="fa-solid fa-trash"></i></a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AzureContext context = default!;

    protected override void OnInitialized()
    {
       // Fetches text answers in db to show in the table.
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    
}
