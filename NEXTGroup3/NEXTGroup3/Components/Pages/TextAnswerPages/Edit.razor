@page "/textanswers/edit"
@using Microsoft.EntityFrameworkCore
@using NEXTGroup3.Models
@using NEXTGroup3.Components.Layout
@layout StaffDashboardLayout
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>TextAnswer</h2>
<hr />
@if (TextAnswer is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="TextAnswer" OnValidSubmit="UpdateTextAnswer" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="TextAnswer.Id" value="@TextAnswer.Id" />
                <div class="mb-3">
                    <label for="answers" class="form-label">Answers:</label>
                    <InputText id="answers" @bind-Value="TextAnswer.Answers" class="form-control" />
                    <ValidationMessage For="() => TextAnswer.Answers" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="roleid" class="form-label">RoleId:</label>
                    <InputNumber id="roleid" @bind-Value="TextAnswer.RoleId" class="form-control" />
                    <ValidationMessage For="() => TextAnswer.RoleId" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/textanswers">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private TextAnswer? TextAnswer { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        TextAnswer ??= await context.TextAnswer.FirstOrDefaultAsync(m => m.Id == Id);

        if (TextAnswer is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task UpdateTextAnswer()
    {
       // Update the TextAnswer in the database by changing the state in the bindvalue modification.
        using var context = DbFactory.CreateDbContext();
        context.Attach(TextAnswer!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!TextAnswerExists(TextAnswer!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/textanswers");
    }

    private bool TextAnswerExists(int id)
    {
       // Check if the TextAnswer exists in the database.
        using var context = DbFactory.CreateDbContext();
        return context.TextAnswer.Any(e => e.Id == id);
    }
}
