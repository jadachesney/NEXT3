 @page "/candidates/delete" 
@using Microsoft.AspNetCore.Identity
 @using Microsoft.EntityFrameworkCore 
 @using NEXTGroup3.Models 
 @using System.Security.Claims
 @inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory 
 @inject AuthenticationStateProvider AuthenticationStateProvider
 @inject NavigationManager NavigationManager 
 @inject UserManager<NextUser> userManager
@attribute [Authorize(Roles = "Admin, Candidate")]

<PageTitle>Delete</PageTitle> 
<CascadingAuthenticationState>
  <AuthorizeView Context="authContext">
    <Authorized>
      <h1>Delete</h1> 
      <p>Are you sure you want to delete this?</p>
      <div> 
          <h2>Candidate</h2> 
          <hr />
        <dl class="row"> 
              <dt class="col-sm-2">Email</dt> 
              <dd class="col-sm-10">@email</dd> 
          </dl> 
          <dl class="row"> 
              <dt class="col-sm-2">Password</dt> 
              <dd class="col-sm-10">@password</dd>
          </dl> 
          <EditForm method="post" Model="@LoginModel" OnValidSubmit="DeleteCandidate" FormName="@deleteForm"> 
              <button type="submit" class="btn btn-danger">Delete</button> 
              <a href="/candidates">Back to List</a> 
          </EditForm> 
      </div> 
    </Authorized>
    <NotAuthorized></NotAuthorized>
  </AuthorizeView>
</CascadingAuthenticationState>

@code {

  [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
  private const string deleteForm = "DeleteForm";
  [SupplyParameterFromForm(FormName = deleteForm)] public LoginModel LoginModel { get; set; } = new(); 

  [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; }

  private string email;
  private string password;


  protected override async Task OnInitializedAsync() 
  { 
    var authstate = await AuthenticationState;
    var user = authstate.User;

    if (user.Identity != null && user.Identity.IsAuthenticated)
    {
      email = user.FindFirst(ClaimTypes.Email)?.Value ?? "Unknown User";
      password = user.FindFirst(ClaimTypes.Hash)?.Value ?? "Unkknown";
    }
    else
    {
      email = "Guest";
    }
  } 

     private async Task DeleteCandidate() 
     { 
