 @page "/candidates/delete" 
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore 
@using NEXTGroup3.Components.Layout
@using NEXTGroup3.Models 
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using System.Security.Claims
@using NEXTGroup3.Services
@using NEXTGroup3
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory 
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager 
@inject UserManager<NextUser> userManager
@layout CandidateDashboardLayout
@rendermode InteractiveAuto
@attribute [Authorize(Roles = "Candidate")]

<PageTitle>Delete</PageTitle> 
<CascadingAuthenticationState>
  <AuthorizeView Context="authContext">
    <Authorized>
      <h1>Delete</h1> 
      <p>Are you sure you want to delete this?</p>
      <div> 
          <h2>Candidate</h2> 
          <hr />
          <dl class="row">
            <dt class="col-sm-2">First Name</dt>
            <dd class="col-sm-10">@firstName</dd>
          </dl>
          <dl class="row"> 
              <dt class="col-sm-2">Email</dt> 
              <dd class="col-sm-10">@email</dd> 
          </dl>
        <EditForm method="post" Model="@LoginModel" OnValidSubmit="DeleteCandidate" FormName="DeleteForm">
          <div class="mb-3">
            <label for="password" class="form-label">Password:</label>
            <InputText id="password" @bind-Value="LoginModel.Password" class="form-control" />
          </div>
          <button type="submit" class="btn btn-danger">Delete</button>
          <a href="/candidatedashboard">Back to List</a>
        </EditForm>
      </div> 
    </Authorized>
    <NotAuthorized></NotAuthorized>
  </AuthorizeView>
</CascadingAuthenticationState>

@code {

  [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
  public LoginModel LoginModel { get; set; } = new(); 

  [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; }

  private string email;
  private string firstName;

  protected override async Task OnInitializedAsync() 
  { 
    var authstate = await AuthenticationState;
    var user = authstate.User;

    if (user.Identity != null && user.Identity.IsAuthenticated)
    {
      email = user.FindFirst(ClaimTypes.Email)?.Value ?? "Unknown User";
      firstName = user.FindFirst(ClaimTypes.Name)?.Value ?? "Unknown User";
      LoginModel.Email = email;
    }
  } 

  private async Task DeleteCandidate() 
  {
    var candidate = await userManager.FindByEmailAsync(LoginModel.Email);
    var isValid = await userManager.CheckPasswordAsync(candidate, LoginModel.Password);

    var claims = await userManager.GetClaimsAsync(candidate);
    foreach (var claim in claims)
    {
      await userManager.RemoveClaimAsync(candidate, claim);
    }

    var deleteResult = await userManager.DeleteAsync(candidate);
    if (deleteResult.Succeeded)
    {

      NavigationManager.NavigateTo("/");
    }
  } 
 } 