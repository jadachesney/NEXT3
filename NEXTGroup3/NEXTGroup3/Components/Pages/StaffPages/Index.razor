@page "/staff"
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using NEXTGroup3.Components.Layout
@using NEXTGroup3.Models
@using NEXTGroup3.Data
@using System.Security.Claims
@layout StaffDashboardLayout
@inject UserManager<NextUser> userManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="staff/create">Create New</a>
</p>

<QuickGrid Class="table" Items="staff">
    <PropertyColumn Property="StaffId" />
    <PropertyColumn Property="Email" />

    <TemplateColumn Context="staff">
        <a href="@($"staff/edit?id={staff.Id}")">Edit</a> |
        <a href="@($"staff/details?id={staff.Id}")">Details</a> |
        <a href="@($"staff/delete?id={staff.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;

    private IList<NextUser> staff;

    protected override async Task OnInitializedAsync()
    {
        staff = await userManager.GetUsersInRoleAsync("Staff");
    }



