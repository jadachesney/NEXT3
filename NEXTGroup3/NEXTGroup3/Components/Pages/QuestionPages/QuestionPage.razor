@page "/"
@rendermode InteractiveAuto
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory
@using NEXTGroup3.Services

@inject RoleService roleService
@inject RangeQuestionService rangeQuestionService
<div class="question-container">
    @if (currentQuestionIndex < rangeQuestions.Count)
    {
        <RBQuestion rangeQuestion="rangeQuestions[currentQuestionIndex]" OnAnswerSelected="AnswerSelected" />
        <p>@testpoints @testSide</p>
    }
    else
    {
        <p>All questions answered</p>
    }
</div>



<PageTitle>Question Page</PageTitle>
 
  <div class="question-container">
      @foreach (var question in rangeQuestions)
      {
          <RBQuestion rangeQuestion=question />
      }
    
      @if(!rolesLoaded){
        <p>Loading...</p>
      }
      else
      {
          <TBCode roles=roles></TBCode>
      }
  </div>
  


@code {
    private List<Role> roles;
    private bool rolesLoaded = false;
    private Department department = new Department();

    //Database
    private List<RangeQuestion> rangeQuestions = new List<RangeQuestion>();

    protected override async Task OnInitializedAsync()
    {
        department.Id = 1; //PLACEHOLDER VALUE
        roles = await roleService.GetAllRolesInDepartment(department); //Fetch data from the API
        rolesLoaded = true;
        rangeQuestions = await rangeQuestionService.GetAllRangeQuestions();
    }

    //functionality for range questions
    public int currentQuestionIndex = 0;
    public int testpoints;
    public bool testSide;

    public async Task AnswerSelected((int points, bool departmentListSide) answer)
    {
        Console.WriteLine("feedback received");
        await Task.Delay(500);
        testpoints = answer.points;
        testSide = answer.departmentListSide;

        currentQuestionIndex++;
        StateHasChanged();
    }

    // public void AnswerSelected((int points, bool departmentListSide) answer)
    // {
    //     testpoints = answer.points;
    //     testSide = answer.departmentListSide;
    // }
}

