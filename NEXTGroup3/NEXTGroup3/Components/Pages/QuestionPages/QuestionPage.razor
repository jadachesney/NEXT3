@page "/questionpage"
@rendermode InteractiveAuto
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory
@using NEXTGroup3.Services
@* @inject RangeQuestionService rangeQuestionService *@
@inject RoleService roleService

<PageTitle>Question Page</PageTitle>

<h3>QuestionPage</h3>

@code {
    private List<Role> roles;
    private bool rolesLoaded = false;
    private Department department = new Department();


    protected override async Task OnInitializedAsync()
    {
        department.Id = 1; //PLACEHOLDER VALUE
        roles = await roleService.GetAllRolesInDepartment(department); //Fetch data from the API
        rolesLoaded = true;
    }
}
<div class="question-container">
    @if(!rolesLoaded){
        <p>Loading...</p>
    }
    else
    {
        <TBCode roles=roles></TBCode>
    }
</div>