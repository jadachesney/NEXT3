@page "/"
@rendermode InteractiveServer
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory
@using NEXTGroup3.Services
@inject RangeQuestionService rangeQuestionService
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage ProtectedSessionStore

<PageTitle>Question Page</PageTitle>

<div class="question-container">
    <div class="range-content">
        <div class="range-question">
            <div class="range-answer-container">
                @if (currentQuestionIndex < rangeQuestions.Count)
                {
                    <h3>Question @rangeQuestions[currentQuestionIndex].Id / @rangeQuestions.Count()</h3>
                    <form class="range">
                        <RBQuestion rangeQuestion="rangeQuestions[currentQuestionIndex]" OnAnswerSelected="HandleAnswerSelected" />
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@code {
    public Result result = new Result();
    private int currentQuestionIndex = 0;
    //dynamic

    private List<RangeQuestion> rangeQuestions = new List<RangeQuestion>();

    //Database
    protected override async Task OnInitializedAsync()
    {
        rangeQuestions = await rangeQuestionService.GetAllRangeQuestions();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var result = await ProtectedSessionStore.GetAsync<int>("CurrentQuestionIndex");
            currentQuestionIndex = result.Success ? result.Value : 0;
            StateHasChanged();
        }
    }

    //functionality for range questions
    private async Task HandleAnswerSelected(int selectedValue)
    {
        System.Console.WriteLine($"Selected Answer: {selectedValue}");
        currentQuestionIndex++;
        await SaveCurrentQuestionIndex();
        StateHasChanged();
    }
    private async Task SaveCurrentQuestionIndex()
    {
        await ProtectedSessionStore.SetAsync("CurrentQuestionIndex", currentQuestionIndex);
    }
}

