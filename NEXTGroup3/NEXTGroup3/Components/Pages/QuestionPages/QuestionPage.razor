@page "/question"
@rendermode InteractiveServer
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory
@using NEXTGroup3.Services
@inject RangeQuestionService rangeQuestionService
@inject TextAnswerService textAnswerService
@inject RoleService roleService
@inject ResultService resultService
@inject DepartmentService departmentService

<PageTitle>Question Page</PageTitle>

<div class="question-container">
    <div class="range-content">
        <div class="range-question">
            <div class="range-answer-container">
                @if(!rangeQuestionService.OnTextQuestions)
                {
                    @for (int i = 0; i <= rangeQuestions.Count(); i++)
                    {
                        if (i == 0 && rangeQuestionService.OnRangeQuestions == false)
                        {
                            <h5>Please start by selecting any of the below departments you are particularly interested in:</h5>
                            <p>You may continue without selecting any</p>
                            foreach (InitiallySelectedDepartments department in initiallySelectedDepartments)
                            {
                                <InputCheckbox id=@department.Department.Id @bind-value="@department.IsSelected"/>
                                <label for=@department.Department.Id>@department.Department.Name</label>
                                <br />
                            }
                            <button class="range-submit-btn" @onclick="HandleInitialDepartmentSelected">Next</button>
                        }
                        else if (rangeQuestionService.OnRangeQuestions == true && rangeQuestionService.CurrentQuestionIndex < rangeQuestions.Count() && rangeQuestionService.CurrentQuestionIndex == i - 1)
                        {
                            <h5>Section 1 / 2</h5>
                            <h3>Question @(i) / @rangeQuestions.Count()</h3>
                            <p>@rangeQuestions[i - 1].QuestionText</p>
                            <div class="button-group">
                                <InputRadioGroup id="radio-button" @bind-Value="answer"> 
                                    @for(int v = 0; v < 5; v++)
                                    {
                                        <div class="form-group">
                                            <label class="range-answer-label" for=@v> @(rangeAnswerChoices[v]) </label>
                                            <InputRadio Value=@v id=@v class="range-answer-btn"/>
                                        </div>
                                    }
                                </InputRadioGroup>
                            </div>
                            <button class="range-submit-btn" @onclick="HandleAnswerSelected">Next</button>
                        }
                    }
                }
                @if(rangeQuestionService.OnTextQuestions)
                {
                    int questionCount = textAnswerService.QuestionMax;
                    for(int i = 0; i < questionCount; i++)
                    {
                        if (textAnswerService.CurrentQuestionIndex < questionCount && textAnswerService.CurrentQuestionIndex == i)
                        {
                            <h5>Section 2 / 2</h5>
                            <h3>Question @(i + 1) / @questionCount</h3>
                            <h5>Select which of the following statements you agree with the most:</h5>
                            <div class="text-answer-container">
                                <InputRadioGroup id="radio-button" @bind-Value="@answer">
                                    @for (int answerIndex = 0; answerIndex < selectedAnswers.Count; answerIndex++) //iterates over all selected answers
                                    {
                                        var answerText = selectedAnswers[answerIndex].Answers;
                                        var answerId = selectedAnswers[answerIndex].Id;
                                        var answerIdString = "text-answer-" + selectedAnswers[answerIndex].Id.ToString();

                                        <div id="" class="text-answer-form-group form-group">
                                            <InputRadio Value=@answerId id="@answerIdString" class="text-answer-radio" hidden /><label class="btn btn-outline-dark text-answer-btn" for="@answerIdString">@answerText</label>
                                        </div>
                                    }
                                    <div id="" class="text-answer-form-group form-group">
                                        <InputRadio Value=0 id="text-answer-0" class="text-answer-radio" hidden /><label class="btn btn-outline-dark text-answer-btn" for="text-answer-0">None</label>
                                    </div>
                                </InputRadioGroup>
                            </div>
                            <button class="text-submit-button" @onclick="HandleAnswerSelected">Next</button>
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    public int answer = 2;

    // INITIAL DEPARTMENT SELECTION
    private List<InitiallySelectedDepartments> initiallySelectedDepartments = new List<InitiallySelectedDepartments>(); 

    // RANGE BASED VARIABLES
    private List<RangeQuestion> rangeQuestions = new List<RangeQuestion>(); // list of all range questions
    private List<Department> departments = new List<Department>();
    private string[] rangeAnswerChoices = { "Strongly Disagree", "Disagree", "Neutral", "Agree", "Strongly Agree" };
    private List<DepartmentRangeQuestion> departmentRangeQuestions = new List<DepartmentRangeQuestion>();   // list of the all relationships between departments and questions

    // TEXT BASED VARIABLES
    private List<TextAnswer> textAnswers = new List<TextAnswer>();  
    private List<Role> roles = new List<Role>(); //stores the roles to be sent to the TBCode component
    private Department departmentForTextQuestions = new Department(); //stores the department result from rangeQuestions
    private bool rolesSelected = false; // a flag for whether or not roles has been populated
    private List<TextAnswer> selectedAnswers = new List<TextAnswer>();//stores answers selected by the following function
    private bool nextTextQuestion = true;

    //Database
    protected override async Task OnInitializedAsync()
    {
        //---RANGE BASED FUNCTIONS---//
        departments = await departmentService.GetAllDepartments();
        departmentRangeQuestions = await resultService.GetAllDepartmentRangeQuestions();
        rangeQuestions = await rangeQuestionService.GetAllRangeQuestions();
        initiallySelectedDepartments = departments.Select(d => new InitiallySelectedDepartments(d)).ToList();
    }

    private void HandleInitialDepartmentSelected()
    {
        foreach (InitiallySelectedDepartments department in initiallySelectedDepartments)
            if(department.IsSelected)
                resultService.DepartmentPoints[department.Department.Id - 1].Points += 3;
        rangeQuestionService.OnRangeQuestions = true;
    }

    private async Task HandleAnswerSelected()
    {
        if(answer >= 0){

            if (rangeQuestionService.OnTextQuestions == false)
            {
                AddDepartmentPoints();
                rangeQuestionService.CurrentQuestionIndex++;
                answer = 2;
                if (rangeQuestionService.CurrentQuestionIndex == rangeQuestions.Count())
                    await GetHighestDepartmentTextAnswers();
            }
            else
            {
                int currentQuestionIndex = textAnswerService.CurrentQuestionIndex;
                int questionMax = textAnswerService.QuestionMax;

                //handles point values for the answer provided
                if(currentQuestionIndex >= 0 && currentQuestionIndex < questionMax - 1) 
                    AddRolePoints(answer);

                else if (textAnswerService.CurrentQuestionIndex == textAnswerService.QuestionMax - 1 && textAnswerService.CurrentQuestionIndex != 0) 
                    EndQuestionnaire();


                //selects a new set of text answers
                await SelectTextAnswers();

                //moves onto the next text based question and resets answer to none of the above
                textAnswerService.CurrentQuestionIndex++;
            }

            // ending the questionnaire

            StateHasChanged();
        }
    }

    private async Task SelectTextAnswers()
    {
        selectedAnswers.Clear();
        //runs when the "answers" parameter is set
        if (selectedAnswers.Count < 3)
        {
            //Randomly selects 5 unique answers from textAnswers
            Random rng = new Random(); //new random number generator

            for (int i = 0; i < 3;)
            {
                TextAnswer current = textAnswers[rng.Next(0, textAnswerService.availableAnswers.Count())];

                if (!selectedAnswers.Contains(current)
                && textAnswerService.CurrentQuestionIndex >= textAnswerService.QuestionMax / 2
                && textAnswerService.countAnswerDisplay[current.Id] == 0)
                {

                    //ensures answer uniqueness and only increments if a unique answer is added
                    selectedAnswers.Add(current);

                    // increments both the selected answer's counter and the loop
                    textAnswerService.countAnswerDisplay[current.Id]++; i++;
                }

                else if (!selectedAnswers.Contains(current))
                {
                    //ensures answer uniqueness and only increments if a unique answer is added
                    selectedAnswers.Add(current);

                    // increments both the selected answer's counter and the loop
                    textAnswerService.countAnswerDisplay[current.Id]++; i++;

                    if (textAnswerService.countAnswerDisplay[current.Id] == 2) textAnswerService.availableAnswers.Remove(current);


                }

                else if (textAnswerService.availableAnswers.Count() != 0) textAnswerService.countAnswerDisplay[current.Id] = 2;

                if(textAnswerService.availableAnswers.Count == 0) i = 3; // closes loop if no more answers are available
                
            }
            answer = -1;
        }
    }

    //adds points to the correct role in RolePoints
    private void AddRolePoints(int answerId)
    {
        int roleId = roleService.GetRoleIdFromTextQuestion(answerId);
        //finds correct point object
        foreach (var point in resultService.RolePoints)
        {
            if (point.Id == roleId)
            {
                point.Points += 3;
            }
        }
    }

    //adds points to the correct department in DepartmentPoints
    private void AddDepartmentPoints()
    {
        switch (answer)
        {
            case 0:
                foreach (Department department in rangeQuestions[rangeQuestionService.CurrentQuestionIndex].LeftDepartments)
                    resultService.DepartmentPoints[department.Id - 1].Points += 4;
                break;
            case 1:
                foreach (Department department in rangeQuestions[rangeQuestionService.CurrentQuestionIndex].LeftDepartments)
                    resultService.DepartmentPoints[department.Id - 1].Points += 2;
                break;
            case 2:
                foreach (Department department in departments)
                {
                    if (!rangeQuestions[rangeQuestionService.CurrentQuestionIndex].LeftDepartments.Contains(department) &&
                        !rangeQuestions[rangeQuestionService.CurrentQuestionIndex].RightDepartments.Contains(department))
                    {
                        resultService.DepartmentPoints[department.Id - 1].Points += 1;
                    }
                }
                break;
            case 3:
                foreach (Department department in rangeQuestions[rangeQuestionService.CurrentQuestionIndex].RightDepartments)
                    resultService.DepartmentPoints[department.Id - 1].Points += 2;
                break;
            case 4:
                foreach (Department department in rangeQuestions[rangeQuestionService.CurrentQuestionIndex].RightDepartments)
                    resultService.DepartmentPoints[department.Id - 1].Points += 4;
                break;
            default:
                Console.WriteLine("Error distributing points");
                break;
        }
    }

    //retrieves text answers from the highest scoring department
    private async Task GetHighestDepartmentTextAnswers()
    {
        int maxPoint = resultService.DepartmentPoints.Max(p => p.Points);
        Point[] departmentsWithMaxPoint = resultService.DepartmentPoints.Where(p => p.Points == maxPoint).ToArray();

        if (departmentsWithMaxPoint.Count() > 1)
        {
            // we make it possible to insert 2 departments for the text questions? - possible later
            departmentForTextQuestions = departments.Where(d => d.Id == departmentsWithMaxPoint[0].Id).First();
        }
        else departmentForTextQuestions = departments.Where(d => d.Id == departmentsWithMaxPoint[0].Id).First();

        // departmentForTextQuestions.Id = 1; 

        await InitializeTextAnswers();
    }

    //retrieves text answers
    private async Task InitializeTextAnswers(){

        textAnswers = await textAnswerService.GetTextAnswersFromDepartment(departmentForTextQuestions);
        textAnswerService.availableAnswers = textAnswers;

        for (int i = 0; i < textAnswers.Count(); i++) {
            textAnswerService.countAnswerDisplay.Add(textAnswers[i].Id, 0);
        }
        await textAnswerService.CalculateQuestionMax(textAnswers.Count());

        // decides the answers that will display for the current question
        await SelectTextAnswers();

        resultService.InitializeRolePoints(departmentForTextQuestions);

        //flags true when roles related to the department have been populated
        rolesSelected = true; 
        rangeQuestionService.OnTextQuestions = true;

    }

    //checks and stores which role has the highest score
    private async void CheckMaxRolePoint()
    {
        List<Role> roles = await roleService.GetAllRolesInDepartment(departmentForTextQuestions);

        int maxPoint = resultService.RolePoints.Max(p => p.Points);
        Point[] rolesWithMaxPoint = resultService.RolePoints.Where(p => p.Points == maxPoint).ToArray();
    }

    public void EndQuestionnaire(){

        // saving result to database
        resultService.SaveResult();

        // redirect to result page
        NavManager.NavigateTo("/results");
    }

    class InitiallySelectedDepartments
    {
        public Department Department { get; set; }
        public bool IsSelected { get; set; }

        public InitiallySelectedDepartments(Department dep)
        {
            this.Department = dep;
            this.IsSelected = false;
        }
    }
}
