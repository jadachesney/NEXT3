<div class="text-centering">
    <div class="progress" role="progressbar" aria-label="Basic example" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style="width: 25%">

        </div>
    </div>
    <h5 class="mt-3">1/9</h5>


    <div class="text-question mt-5"> 

        <h5>Select which of the following statements you agree with the most:</h5>
    </div>
</div>
<div class="text-answer-container">
    @for(int answerIndex = 0; answerIndex < selectedAnswers.Count; answerIndex++)
    {
        var answerText = selectedAnswers[answerIndex].Answers;
        <button class="btn btn-outline-dark text-answer-btn">@answerText</button>
    }
</div>  

@code {
    [Parameter] public List<TextAnswer> answers { get; set; }
    private List<TextAnswer> selectedAnswers = new List<TextAnswer>();

    protected override async void OnParametersSet(){

        if(selectedAnswers.Count < 5){

            Random rng = new Random();

            for (int i = 0; i < 5;){
                TextAnswer current = answers[rng.Next(answers.Count)];

                if(!selectedAnswers.Contains(current)){
                    selectedAnswers.Add(current);
                    i++;
                }
            }
        }
    }


}
