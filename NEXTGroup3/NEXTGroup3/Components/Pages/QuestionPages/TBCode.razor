@using NEXTGroup3.Services
@inject TextAnswerService textAnswerService


@code {
    [Parameter] public List<Role> roles { get; set; } //retreived via an attribute in the component call
    private bool answersLoaded; //flag that shows if answers have been populated from related roles

    private List<TextAnswer> textAnswers = new List<TextAnswer>(); //stores the output text answers

    protected override async Task OnParametersSetAsync(){ 
        //runs when roles parameter is set

        textAnswers = await textAnswerService.GetTextAnswersFromRoles(roles);
        answersLoaded = true;
    }
}
@if(!answersLoaded){
    <p>Loading...</p> //displays a loading dialogue if textAnswers have not been completely fetched yet
    }
    else
    {
        <TBQuestion answers=@textAnswers></TBQuestion>
    }
