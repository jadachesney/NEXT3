<div class="range-content">
  <div class="range-question">
    <h3>Question @rangeQuestion.Id</h3>
    <p>@rangeQuestion.QuestionText</p>
    <div class="range-answer-container">
      <form class="range">
        <div class="button-group">
          <div class="form-group">
            <label class="range-answer-label">Very Unlikely</label>
            <button class="range-answer-btn"></button>
          </div>
          <div class="form-group">
            <label class="range-answer-label">Somewhat Unlikely</label>
            <button class="range-answer-btn"></button>
          </div>
          <div class="form-group">
            <label class="range-answer-label">Neutral</label>
            <button class="range-answer-btn"></button>
          </div>
          <div class="form-group">
            <label class="range-answer-label">Somewhat Likely</label>
            <button class="range-answer-btn"></button>
          </div>
          <div class="form-group">
            <label class="range-answer-label">Very Likely</label>
            <button class="range-answer-btn"></button>
          </div>
        </div>

        <button type="submit" class="range-submit-btn">Submit</button>
      </form>
    </div>
  </div>
</div>

@code {
    [Parameter]
    public RangeQuestion? rangeQuestion { get; set; }
}
