
<p for="radio-button">@rangeQuestion.QuestionText</p>

<div class="button-group">
    <InputRadioGroup id="radio-button" @bind-Value="answer">    
        <div class="form-group">
            <label class="range-answer-label" for="0">Strongly Disagree</label>
            <InputRadio Value="0" id="0" class="range-answer-btn"/>
        </div>

        <div class="form-group">
            <label class="range-answer-label" for="1">Disagree</label>
            <InputRadio Value="1" id="1" class="range-answer-btn"/>
        </div>

        <div class="form-group">
            <label class="range-answer-label" for="2">Neutral</label>
            <InputRadio Value="2" id="2" class="range-answer-btn"/> 
        </div>

        <div class="form-group">
            <label class="range-answer-label" for="3">Agree</label>
            <InputRadio Value="3" id="3" class="range-answer-btn"/> 
        </div>

        <div class="form-group">
            <label class="range-answer-label" for="4">Strongly Agree</label>
            <InputRadio Value="4" id="4" class="range-answer-btn"/>
        </div>
    </InputRadioGroup>
</div>
<button class="range-submit-btn" @onclick="NotifyAnswerSelected">Next</button>

@code {
    [Parameter]
    public RangeQuestion? rangeQuestion { get; set; }
    public int answer = 2;


    [Parameter]
    public EventCallback<int> OnAnswerSelected { get; set; }

    private void NotifyAnswerSelected()
    {
        System.Console.WriteLine($"Selected answer: {answer}");
        OnAnswerSelected.InvokeAsync(answer);
    }
}
