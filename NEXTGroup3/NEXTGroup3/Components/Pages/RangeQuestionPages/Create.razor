@page "/rangequestions/create"
@using Microsoft.EntityFrameworkCore
@using NEXTGroup3.Models
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>RangeQuestion</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="RangeQuestion" OnValidSubmit="AddRangeQuestion" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="questiontext" class="form-label">QuestionText:</label> 
                <InputText id="questiontext" @bind-Value="RangeQuestion.QuestionText" class="form-control" /> 
                <ValidationMessage For="() => RangeQuestion.QuestionText" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/rangequestions">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private RangeQuestion RangeQuestion { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddRangeQuestion()
    {
        using var context = DbFactory.CreateDbContext();
        context.RangeQuestion.Add(RangeQuestion);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/rangequestions");
    }
}
