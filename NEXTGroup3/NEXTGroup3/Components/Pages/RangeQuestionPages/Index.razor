@page "/rangequestions"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using NEXTGroup3.Components.Layout
@layout StaffDashboardLayout
@using NEXTGroup3.Models
@using NEXTGroup3.Data
@implements IAsyncDisposable
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory
<script src="https://kit.fontawesome.com/043f66280d.js" crossorigin="anonymous"></script>

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<QuickGrid Class="table" Items="context.RangeQuestion">
    <PropertyColumn Property="rangequestion => rangequestion.QuestionText" />

    <TemplateColumn Context="rangequestion" class="icon-tb">
        <a href="@($"rangequestions/edit?id={rangequestion.Id}")"><i class="fa-solid fa-pen"></i></a> |
        <a href="@($"rangequestions/details?id={rangequestion.Id}")"><i class="fa-solid fa-info"></i></a> |
    </TemplateColumn>
</QuickGrid>

@code {
    private AzureContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
