@page "/candidateprofile"
@using NEXTGroup3.Models
@using Microsoft.EntityFrameworkCore
@using NEXTGroup3.Services
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject LoginManagerService loginManagerService

<CascadingAuthenticationState>
    <h3>User Profile</h3>
        <input type="hidden" name="candidate.Id" value="@candidate.Id" />

        <div class="form-group">
            <label for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="candidate.Email" />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <InputText id="password" class="form-control" @bind-Value="candidate.Password" />
        </div>



    <div>
        <a href="/candidates/edit?Id=@candidate.Id">Edit Profile</a>
    </div>

    <div>
        <a href="/candidates/delete?Id=@candidate.Id">Delete Profile</a>
    </div>

</CascadingAuthenticationState>


@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Candidate? Candidate { get; set; }

    Candidate candidate = new Candidate();

    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadUserProfile();
    }

    private async Task LoadUserProfile()
    {
        var authenticationState = await authenticationStateTask;
        var username = authenticationState.User.Identity.Name;
        candidate.Password = "";

        if (string.IsNullOrEmpty(username))
        {
            return;
        }

        using var context = DbFactory.CreateDbContext();
        var Candidate = await context.Candidate
            .FirstOrDefaultAsync(u => u.Email == username);


        if (Candidate != null)
        {
            candidate.Email = Candidate.Email;
            candidate.Id = Candidate.Id;
            candidate.Password = loginManagerService.HashPassword(candidate.Password);
        }

        StateHasChanged();
    }

    private async Task DeleteProfile()
    {
        var authenticationState = await authenticationStateTask;
        var username = authenticationState.User.Identity.Name;

        if (string.IsNullOrEmpty(username))
        {
            return;
        }

        using var context = DbFactory.CreateDbContext();
        var candidateToDelete = await context.Candidate
            .FirstOrDefaultAsync(c => c.Email == username);

        if (candidateToDelete != null)
        {
            context.Candidate.Remove(candidateToDelete);
            await context.SaveChangesAsync();

            NavigationManager.NavigateTo("/");

        }

    }

    private async Task EditProfile()
    {


        Console.Write("SAVED PROFILE CHANGES??");
        using var context = DbFactory.CreateDbContext();
        context.Attach(Candidate!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/profile");
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!CandidateExists(Candidate!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

    }

    private bool CandidateExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Candidate.Any(e => e.Id == id);
    }
}


