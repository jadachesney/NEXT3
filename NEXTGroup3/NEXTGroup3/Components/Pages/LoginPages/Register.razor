@page "/register"
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=arrow_left" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=arrow_right" />
@using Microsoft.AspNetCore.Identity
@using NEXTGroup3.Models
@using NEXTGroup3.Services
@using Microsoft.AspNetCore.Cryptography.KeyDerivation;
@using System.Security.Cryptography;
@using Microsoft.AspNetCore.Identity;
@using System.Runtime.CompilerServices
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory
@inject NavigationManager NavigationManager
@inject LoginManagerService loginManagerService

<body>
  <div class="register-container">
    <header>
      <h1 class="register-header">
        Register a Candidate Account
      </h1>
    </header>
    <EditForm method="post" Model="Candidate" OnValidSubmit="AddCandidate" FormName="create" Enhance>
      <DataAnnotationsValidator />
      <ValidationSummary class="text-danger" role="alert" />
      <div class="register-form">
        <section class="register-content">
          <div class="text-row">
            <p1 class="register-text">
              Enter your information to save your results and receive marketing insights from potential employers.
            </p1>
          </div>
          <div class="information-input">
            <div class="input-spacer">
              <div class="email-text">
                <label class="email-input">
                  <span class="email-input-label">
                    Email Address
                  </span>
                  <span class="verification-star">
                    *
                  </span>
                </label>
              </div>
              <InputText id="email" @bind-Value="Candidate.Email" class="input-row" />
              <ValidationMessage For="() => Candidate.Email" class="text-danger" />
            </div>
            <div class="input-spacer">
              <div class="password-text">
                <label class="password-input">
                  <span class="password-input-label">
                    Password
                  </span>
                  <span class="verification-star">
                    *
                  </span>
                </label>
              </div>
              <InputText id="password" @bind-Value="Candidate.Password" class="input-row" />
              <ValidationMessage For="() => Candidate.Password" class="text-danger" />
            </div>
          </div>
        </section>
      </div>
      <span class="text-danger"> @errorMessage</span>
      <footer class="buttons-bar">
        <div class="buttons-bar-inner">
          <NavLink href="/" class="login-btn">
            <span class="button-label">Back</span>
            <span class="material-symbols-outlined-left button-arrow button-arrow-left">
              arrow_left
            </span>
          </NavLink>
          <div class="buttons-spacer"></div>
          <button type="submit" class="login-btn">
            <span class="button-label">Create</span>
            <span class="material-symbols-outlined button-arrow button-arrow-right">
              arrow_right
            </span>
          </button>
        </div>
      </footer>
    </EditForm>
  </div>
</body>

<EditForm method="post" Model="Candidate" OnValidSubmit="AddCandidate" FormName="create" Enhance>
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" role="alert" />
    <div class="mb-3">
        <label for="email" class="form-label">Email:</label>
        <InputText id="email" @bind-Value="Candidate.Email" class="form-control" />
        <ValidationMessage For="() => Candidate.Email" class="text-danger" />
    </div>
    <div class="mb-3">
        <label for="password" class="form-label">Password:</label>
        <InputText id="password" @bind-Value="Candidate.Password" class="form-control" />
        <ValidationMessage For="() => Candidate.Password" class="text-danger" />
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
</EditForm>

@code {
  [SupplyParameterFromForm] private Candidate Candidate { get; set; } = new();

  private string? errorMessage;


    private async Task AddCandidate()
    {

        using var context = DbFactory.CreateDbContext();
        // Check if the email already exists
        if (!context.Candidate.Any(x => x.Email == Candidate.Email))
        {
            Candidate.Password = loginManagerService.HashPassword(Candidate.Password);

            context.Candidate.Add(Candidate);
            await context.SaveChangesAsync();

            NavigationManager.NavigateTo("/CandidateLogin");
        }
        else
        {
            Console.WriteLine("ERROR: Candidate with this email already exists.");
        }

    }


}

