@page "/register"
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=arrow_left" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=arrow_right" />
@using Microsoft.AspNetCore.Identity
@using NEXTGroup3.Models
@using NEXTGroup3.Services
@using Microsoft.AspNetCore.Cryptography.KeyDerivation;
@using System.Security.Cryptography;
@using System.Runtime.CompilerServices
@inject UserManager<NextUser> userManager
@inject NavigationManager NavigationManager
@inject LoginManagerService loginManagerService

<body>
  <div class="register-container">
    <header>
      <h1 class="register-header">
        Register a Candidate Account
      </h1>
    </header>
    <EditForm method="post" Model="@RegisterModel" OnValidSubmit="AddCandidate" FormName="@registerForm">
      <DataAnnotationsValidator />
      <ValidationSummary class="text-danger" role="alert" />
      <div class="register-form">
        <section class="register-content">
          <div class="text-row">
            <p1 class="register-text">
              Enter your information to save your results and receive marketing insights from potential employers.
            </p1>
          </div>
          <div class="information-input">
            <div class="input-spacer">
              <!-- CANDIDATE EMAIL -->
              <div class="email-text">
                <label class="email-input">
                  <span class="email-input-label">
                    Email Address
                  </span>
                  <span class="verification-star">
                    *
                  </span>
                </label>
              </div>
              <InputText id="email" @bind-Value="RegisterModel.Email" class="input-row" />
              <ValidationMessage For="() => RegisterModel.Email" class="text-danger" />
            </div>
            <div class="input-spacer">
              <!-- CANDIDATE FIRST NAME -->
              <div class="email-text">
                <label class="email-input">
                  <span class="email-input-label">
                    First Name
                  </span>
                  <span class="verification-star">
                    *
                  </span>
                </label>
              </div>
              <InputText id="first-name" @bind-Value="RegisterModel.FirstName" class="input-row" />
              <ValidationMessage For="() => RegisterModel.FirstName" class="text-danger" />
            </div>
            <!-- CANDIDATE LAST NAME -->
            <div class="input-spacer">
              <div class="email-text">
                <label class="email-input">
                  <span class="email-input-label">
                    Last Name
                  </span>
                  <span class="verification-star">
                    *
                  </span>
                </label>
              </div>
              <InputText id="last-name" @bind-Value="RegisterModel.LastName" class="input-row" />
              <ValidationMessage For="() => RegisterModel.LastName" class="text-danger" />
            </div>
            <div class="input-spacer">
              <!-- CANDIDATE PASSWORD -->
              <div class="password-text">
                <label class="password-input">
                  <span class="password-input-label">
                    Password
                  </span>
                  <span class="verification-star">
                    *
                  </span>
                </label>
              </div>
              <InputText id="password" @bind-Value="RegisterModel.Password" class="input-row" />
              <ValidationMessage For="() => RegisterModel.Password" class="text-danger" />
            </div>
          </div>
        </section>
      </div>
      <span class="text-danger"> @errorMessage</span>
      <footer class="buttons-bar">
        <div class="buttons-bar-inner">
          <NavLink href="/" class="login-btn">
            <span class="button-label">Back</span>
            <span class="material-symbols-outlined-left button-arrow button-arrow-left">
              arrow_left
            </span>
          </NavLink>
          <div class="buttons-spacer"></div>
          <button type="submit" class="login-btn">
            <span class="button-label">Create</span>
            <span class="material-symbols-outlined button-arrow button-arrow-right">
              arrow_right
            </span>
          </button>
        </div>
      </footer>
    </EditForm>
  </div>
</body>


@code {
  private const string registerForm = "RegisterForm";
  [SupplyParameterFromForm(FormName = registerForm)] private RegisterModel RegisterModel { get; set; } = new();

  private string? errorMessage;

  private async Task AddCandidate()
  {
    var user = new NextUser { UserName = RegisterModel.Email, FirstName = RegisterModel.FirstName, LastName = RegisterModel.LastName, Email = RegisterModel.Email };
    var result = await userManager.CreateAsync(user, RegisterModel.Password);
    
    if (result != null)
    {
      NavigationManager.NavigateTo("/CandidateLogin");
    }
    else
    {
      errorMessage = "Email already exists to a linked account.";
      return;
    }
  }
}

