@page "/StaffLogin"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory
@inject NavigationManager navigationManager
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=arrow_left" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=arrow_right" />

<body>
  <div class="login-container">
    <header>
      <h1 class="login-header">
        Manage Your Staff Profile
      </h1>
    </header>
    <div class="login-form">
      <section class="login-content">
        <div class="text-row">
          <p1 class="login-text">
            Enter your credentials linked to your staff profile. Once your identity is confirmed, you will be able to manage your profile.
          </p1>
         </div>
        <div class="login-input">
          <div class="input-spacer">
            <label class="staff-id-input">
              <span class="id-input-label">
                Staff ID
              </span> 
              <span class="verification-star">
                *
              </span>
            </label>
            <input class="input-row" />
          </div>
          <div class="input-spacer">
            <label class="email-input">
              <span class="email-input-label">
                Email Address
              </span>
              <span class="verification-star">
                *
              </span>
            </label>
            <input class="input-row" />
          </div>
          <div class="input-spacer">
            <label class="password-input">
              <span class="password-input-label">
                Password
              </span>
              <span class="verification-star">
                *
              </span>
            </label>
            <input class="input-row" />
          </div>
        </div>
      </section>
    </div>
    <footer class="buttons-bar">
      <div class="buttons-bar-inner">
        <NavLink href="/" class="login-btn">
          <span class="button-label">Back</span>
          <span class="material-symbols-outlined-left button-arrow button-arrow-left">
            arrow_left
          </span>
        </NavLink>
        <div class="buttons-spacer"></div>
        <NavLink href="staffdashboard" class="login-btn">
          <span class="button-label">Login</span>
          <span class="material-symbols-outlined button-arrow button-arrow-right">
            arrow_right
          </span>
        </NavLink>
      </div>
    </footer>
  </div>
</body>


@code {
  [CascadingParameter] public HttpContext? HttpContext { get; set; }
  [SupplyParameterFromForm] public Staff Model { get; set; } = new();
  private string? errorMessage;

  private async Task Authenticate()
  {
    using var dbContext = DbFactory.CreateDbContext();

    //Checks details exist in database
    var staff = dbContext.Staff.FirstOrDefault(x => x.Email == Model.Email);

    if (staff == null || staff.Password != Model.Password)
    {
      errorMessage = "Invalid credentials";
      return;
    }
    //List of claims created to authenticate the candidate
    var claims = new List<Claim>
        {
            new Claim(ClaimTypes.Name, Model.Email),
            new Claim(ClaimTypes.NameIdentifier, staff.Id.ToString())
        };

    //Identity created based on claims
    var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
    var principal = new ClaimsPrincipal(identity);

    //Signs candidate in and stores claims in an authentication cookie
    await HttpContext.SignInAsync(principal);

    //Redirected to candidate dashboard
    navigationManager.NavigateTo("/StaffDashboard");
  }

}
