@page "/StaffLogin"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using NEXTGroup3.Services
@using Microsoft.AspNetCore.Identity
@using NEXTGroup3
@rendermode InteractiveServer
@inject UserManager<NextUser> userManager
@inject NavigationManager navigationManager
@inject LoginManagerService loginManagerService
@inject IHttpContextAccessor HttpContextAccessor
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=arrow_left" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=arrow_right" />

<body>
  <div class="login-container">
    <header>
      <h1 class="login-header">
        Manage Your Staff Profile
      </h1>
      <style>
        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
        }
      </style>
    </header>
    <div class="login-form">
      <section class="login-content">
        <div class="text-row">
          <p1 class="login-text">
            Enter your credentials linked to your staff profile. Once your identity is confirmed, you will be able to manage your profile.
          </p1>
        </div>
        <EditForm Model="@LoginModel" OnValidSubmit="Authenticate" FormName="@loginForm">
          <DataAnnotationsValidator />
          <div class="login-input">
            <div class="input-spacer">
              <!-- STAFF EMAIL -->
              <label class="email-input">
                <span class="email-input-label">
                  Email Address
                </span>
                <span class="verification-star">
                  *
                </span>
              </label>
              <InputText @bind-Value="LoginModel.Email" placeholder="Email" class="input-row" />
              <ValidationMessage For="() => LoginModel.Email" />
            </div>
            <div class="input-spacer">
              <!-- STAFF PASSWORD -->
              <label class="password-input">
                <span class="password-input-label">
                  Password
                </span>
                <span class="verification-star">
                  *
                </span>
              </label>
              <InputText @bind-Value="LoginModel.Password" type="password" placeholder="Password" class="input-row" />
              <ValidationMessage For="() => LoginModel.Password" />
            </div>
          </div>
          <span class="text-danger">@errorMessage</span>
          <footer class="buttons-bar">
            <div class="buttons-bar-inner">
              <NavLink href="/" class="login-page-btn">
                <span class="button-label">Back</span>
                <span class="material-symbols-outlined-left button-arrow button-arrow-left">
                  arrow_left
                </span>
              </NavLink>
              <div class="buttons-spacer"></div>
              <button type="submit" class="login-page-btn">
                <span class="button-label">Login</span>
                <span class="material-symbols-outlined button-arrow button-arrow-right">
                  arrow_right
                </span>
              </button>
            </div>
          </footer>
        </EditForm>
      </section>
    </div>
  </div>
</body>


@code {
  // Originally we were using this to get the HttpContext, but it was not working. We tried using changing it to the down below example, but didn't get much further.
  // [CascadingParameter] public HttpContext HttpContext { get; set; }
  private const string loginForm = "LoginForm";
  [SupplyParameterFromForm(FormName = loginForm)] public LoginModel LoginModel { get; set; } = new();
  private string? errorMessage;


  private async Task Authenticate()
  {
     
    var staffs = await userManager.GetUsersInRoleAsync("Staff");
        var staff = await userManager.FindByEmailAsync(LoginModel.Email);
        if (!staffs.Contains(staff))
            staff = null;

        var isValid = await userManager.CheckPasswordAsync(staff, LoginModel.Password);
        if (staff == null || !isValid)
        {
            errorMessage = "Invalid email or password.";
            return;
        }

        var roles = await userManager.GetRolesAsync(staff);
        string userRole = "Staff";

        var claims = new List<Claim>
          {
              new Claim(ClaimTypes.NameIdentifier, staff.Id.ToString()),
              new Claim(ClaimTypes.Name, staff.FirstName),
              new Claim(ClaimTypes.Email, LoginModel.Email),
              new Claim(ClaimTypes.Role, userRole)
          };

        var authProperties = new AuthenticationProperties
            {
                IsPersistent = true,
                ExpiresUtc = DateTime.UtcNow.AddMinutes(30)
            };

        //Identity created based on claims
        var identity = new ClaimsIdentity(claims, Constant.Authscheme);

        var principal = new ClaimsPrincipal(identity);

        //Signs staff in and stores claims in an authentication cookie
        try
        {
            // For some reason this HttpContext is true, but the claim becomes false and turns IsAuthenticated to false. This occured after merge to dev.
            HttpContext HttpContext = HttpContextAccessor.HttpContext;
            await HttpContext.SignInAsync(Constant.Authscheme, principal);
            navigationManager.NavigateTo("/", forceLoad: true);
            Console.WriteLine("Sign-in successful.");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Sign-in failed: " + ex.Message);
            Console.WriteLine("Stack Trace: " + ex.StackTrace);
            if (ex.InnerException != null)
            {
                Console.WriteLine("Inner Exception: " + ex.InnerException.Message);
            }
        }

        //Redirected to staff dashboard
        navigationManager.NavigateTo("/StaffDashboard", forceLoad: true);
    }
}
