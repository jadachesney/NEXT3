@page "/results"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using NEXTGroup3.Models
@using NEXTGroup3.Data
@implements IAsyncDisposable
@inject IDbContextFactory<NEXTGroup3.Data.AzureContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="results/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Result">
    <PropertyColumn Property="result => result.Id" />

    <TemplateColumn Context="result">
        <a href="@($"results/edit?id={result.Id}")">Edit</a> |
        <a href="@($"results/details?id={result.Id}")">Details</a> |
        <a href="@($"results/delete?id={result.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AzureContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
